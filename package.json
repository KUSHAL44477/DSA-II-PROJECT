{
  "name": "nearest-parking-slot-finder-core",
  "version": "1.0.0",
  "description": "Academic Data Structures and Algorithms II (DSA-II) Core Engine for Nearest Parking Slot Finder",
  "author": "KUSHAL MAURYA",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "demo": "node --import tsx src/demo.ts",
    "start": "node --import tsx src/index.ts"
  },
  "keywords": [
    "dsa",
    "dijkstra",
    "min-heap",
    "avl-tree",
    "binary-search-tree",
    "threaded-binary-tree",
    "graph",
    "parking-navigation",
    "smart-transportation"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
